[{"updatedAt":"2026-11-21T19:31:46.703Z","createdAt":"2026-11-21T19:21:10.866Z","id":"ZIywovQXbyGwzPeM","name":"AI Secretary - Drafts Only","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":1}]}},"id":"a6346c25-9575-40be-9403-32d6bc2aa395","name":"Every Minute","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[0,400]},{"parameters":{"url":"https://script.google.com/macros/s/AKfycbyCOGo3ZIXszSlG8s2iNrsbdTVpu2NCjzWZkXZ-nyz3AS9CqH7KoQCHBwallIRiQ-o_ag/exec","sendQuery":true,"queryParameters":{"parameters":[{"name":"action","value":"fetch_new"}]},"options":{"timeout":120000}},"id":"09b07b0b-696a-4017-8b3f-56015dcff1d0","name":"Fetch New Mail","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[220,400]},{"parameters":{"fieldToSplitOut":"emails","options":{}},"id":"dac19be6-49cf-490e-81f5-139fef3028ce","name":"Split Emails","type":"n8n-nodes-base.splitOut","typeVersion":1,"position":[440,400]},{"parameters":{"mode":"runOnceForEachItem","jsCode":"\nconst t = \"You are the inbox sorter for a small design studio. Read the email below and pick exactly one of these four categories:\\n\\n- quote: someone asking what something costs, or whether I can do it.\\n- question: someone asking something that isn't about price.\\n- spam: someone selling me something, or a mass mailing.\\n- payment: an invoice, a receipt, a payment problem.\\n\\nRules:\\n- Reply with exactly one word, lowercase, and nothing else: quote, question, spam, or payment.\\n- If an email could fit more than one category, choose the one that matches the sender's main intent \\u2014 what they most want to happen next.\\n- Judge by the email itself, not by who sent it.\\n\\nEmail:\\n{{EMAIL}}\";\nconst e = $input.item.json;\nconst emailText = 'From: ' + (e.from || '') + '\\nSubject: ' + (e.subject || '') + '\\n\\n' + (e.body || '');\nreturn { json: {\n  thread_id: e.thread_id, message_id: e.message_id, from: e.from, subject: e.subject, body: e.body,\n  classifyPrompt: t.split('{{EMAIL}}').join(emailText)\n} };\n"},"id":"3361ef2d-9fc1-4a28-9a30-d4993283df41","name":"Build Classify Prompt","type":"n8n-nodes-base.code","typeVersion":2,"position":[660,400]},{"parameters":{"method":"POST","url":"https://openrouter.ai/api/v1/chat/completions","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ model: 'openrouter/free', temperature: 0, max_tokens: 1500, messages: [{ role: 'user', content: $json.classifyPrompt }] }) }}","options":{"timeout":180000}},"id":"297a1ac4-c201-47ab-abde-ae6eac89641c","name":"Classify (OpenRouter)","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[880,400],"credentials":{"httpHeaderAuth":{"id":"uHbOvfbvUwokqd2Y","name":"OpenRouter Header Auth"}}},{"parameters":{"mode":"runOnceForEachItem","jsCode":"\nconst src = $('Build Classify Prompt').item.json;\nconst msg = ((($input.item.json.choices || [])[0] || {}).message || {});\nconst raw = msg.content || msg.reasoning || '';\nconst all = String(raw).toLowerCase().match(/quote|question|spam|payment/g) || [];\nconst m = all.length ? [all[all.length - 1]] : null;\nreturn { json: {\n  thread_id: src.thread_id, message_id: src.message_id, from: src.from, subject: src.subject, body: src.body,\n  category: m ? m[0] : 'unknown', classifyRaw: String(raw).slice(0, 100)\n} };\n"},"id":"6741237e-069b-4ffe-987a-64dcc6e1251e","name":"Parse Category","type":"n8n-nodes-base.code","typeVersion":2,"position":[1100,400]},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"3b35b3f3-4967-4e7d-81af-879f591ad9a2","leftValue":"={{ $json.category }}","rightValue":"quote","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputLabel":"quote"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"74030538-7685-4889-a756-db181ceb71e1","leftValue":"={{ $json.category }}","rightValue":"question","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputLabel":"question"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"d15e0693-4b98-400f-892e-fb9fd03a411e","leftValue":"={{ $json.category }}","rightValue":"spam","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputLabel":"spam"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"fa256187-b776-434d-a937-23a01a79be1a","leftValue":"={{ $json.category }}","rightValue":"payment","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputLabel":"payment"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"08ac6291-88e2-4e8c-aa9e-6917b9e60e27","leftValue":"={{ $json.category }}","rightValue":"unknown","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputLabel":"unknown"}]},"options":{}},"id":"7891f35f-2182-4582-a85d-abed2500cf4a","name":"Switch by Category","type":"n8n-nodes-base.switch","typeVersion":3.2,"position":[1320,400]},{"parameters":{"url":"https://script.google.com/macros/s/AKfycbyCOGo3ZIXszSlG8s2iNrsbdTVpu2NCjzWZkXZ-nyz3AS9CqH7KoQCHBwallIRiQ-o_ag/exec","sendQuery":true,"queryParameters":{"parameters":[{"name":"action","value":"read_prices"}]},"options":{"timeout":120000}},"id":"bb36d076-6e71-4754-968e-acb0ca36e1fb","name":"Read Prices","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1560,200]},{"parameters":{"mode":"runOnceForEachItem","jsCode":"\nconst t = \"You write reply drafts for a small design studio. You are writing a draft only \\u2014 a person reads and checks every draft before anything is sent.\\n\\nYou will get the customer's email and the studio's price list. Write a short, polite reply draft.\\n\\nRules:\\n- Use only prices that appear in the price list below. Copy them exactly as written. Never invent, estimate, round, or discount a price.\\n- If the customer asks about a service that is not on the price list, do not guess a price. Say plainly that this service isn't on the standard price list, and put the marker [NEEDS PRICE \\u2014 owner to fill in] exactly where the price would go.\\n- Answer what the customer actually asked, using only what the price list supports. Do not promise services, timelines, or terms that are not in the email or the price list.\\n- Keep it short: a greeting, two to four sentences, one clear next step, a polite sign-off. Address the customer by name if they gave one.\\n- Output only the draft email body. No subject line, no notes, no explanation of what you did.\\n\\nCustomer email:\\n{{EMAIL}}\\n\\nPrice list (the only source of prices):\\n{{PRICE_LIST}}\";\nconst src = $('Parse Category').item.json;\nconst items = ($input.item.json.items || []);\nconst priceText = items.map(i => '- ' + i.service + ': ' + i.price).join('\\n');\nconst emailText = 'From: ' + (src.from || '') + '\\nSubject: ' + (src.subject || '') + '\\n\\n' + (src.body || '');\nconst prompt = t.split('{{EMAIL}}').join(emailText).split('{{PRICE_LIST}}').join(priceText);\nreturn { json: {\n  thread_id: src.thread_id, message_id: src.message_id, from: src.from, subject: src.subject, body: src.body,\n  category: src.category, draftPrompt: prompt\n} };\n"},"id":"8b8f69dd-daec-47a7-8858-bd5e6f64eaf6","name":"Build Draft Prompt","type":"n8n-nodes-base.code","typeVersion":2,"position":[1780,200]},{"parameters":{"method":"POST","url":"https://openrouter.ai/api/v1/chat/completions","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ model: 'openrouter/free', temperature: 0.3, max_tokens: 3000, messages: [{ role: 'user', content: $json.draftPrompt }] }) }}","options":{"timeout":180000}},"id":"12806ed6-17c4-4ed8-af72-5bab03c2e363","name":"Draft (OpenRouter)","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2000,200],"credentials":{"httpHeaderAuth":{"id":"uHbOvfbvUwokqd2Y","name":"OpenRouter Header Auth"}}},{"parameters":{"mode":"runOnceForEachItem","jsCode":"\nconst src = $('Build Draft Prompt').item.json;\nconst raw = ((($input.item.json.choices || [])[0] || {}).message || {}).content || '';\nreturn { json: {\n  thread_id: src.thread_id, message_id: src.message_id, from: src.from, subject: src.subject, body: src.body,\n  category: src.category, draftText: String(raw).trim()\n} };\n"},"id":"14e4172e-30da-42eb-94e1-297072147e02","name":"Parse Draft","type":"n8n-nodes-base.code","typeVersion":2,"position":[2220,200]},{"parameters":{"url":"https://script.google.com/macros/s/AKfycbyCOGo3ZIXszSlG8s2iNrsbdTVpu2NCjzWZkXZ-nyz3AS9CqH7KoQCHBwallIRiQ-o_ag/exec","sendQuery":true,"queryParameters":{"parameters":[{"name":"action","value":"draft"},{"name":"message_id","value":"={{ $('Parse Draft').item.json.message_id }}"},{"name":"body","value":"={{ $('Parse Draft').item.json.draftText }}"}]},"options":{"timeout":120000}},"id":"e688424c-e667-4778-9fbf-84b09764c4c5","name":"Create Draft (Relay)","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2440,200]},{"parameters":{"url":"https://script.google.com/macros/s/AKfycbyCOGo3ZIXszSlG8s2iNrsbdTVpu2NCjzWZkXZ-nyz3AS9CqH7KoQCHBwallIRiQ-o_ag/exec","sendQuery":true,"queryParameters":{"parameters":[{"name":"action","value":"log"},{"name":"from","value":"={{ $('Parse Draft').item.json.from }}"},{"name":"subject","value":"={{ $('Parse Draft').item.json.subject }}"},{"name":"category","value":"={{ $('Parse Draft').item.json.category }}"},{"name":"time","value":"={{ $now.toISO() }}"},{"name":"timestamp","value":"={{ $now.toISO() }}"}]},"options":{"timeout":120000}},"id":"02d7fb7e-9142-45f3-bb1c-df4e73540fe5","name":"Log Email","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2660,200]},{"parameters":{"mode":"runOnceForEachItem","jsCode":"\nconst src = $('Parse Draft').item.json;\nconst text = ((src.subject || '') + '\\n' + (src.body || '')).toLowerCase();\nconst pats = [/\\burgent\\b/, /\\basap\\b/, /\\btoday\\b/, /\\bdeadline\\b/,\n  /\\bby (monday|tuesday|wednesday|thursday|friday|saturday|sunday)\\b/,\n  /\\b(january|february|march|april|may|june|july|august|september|october|november|december) \\d{1,2}\\b/,\n  /\\blive by\\b/, /\\bdue (on|by)\\b/];\nreturn { json: { urgent: pats.some(p => p.test(text)), message_id: src.message_id } };\n"},"id":"4a57c9eb-68cf-4530-a69d-18a0fae43658","name":"Urgent Check","type":"n8n-nodes-base.code","typeVersion":2,"position":[2880,200]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"9c7e8d65-0694-40d4-8d79-8e9c25baad7d","leftValue":"={{ $json.urgent }}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"91243fa5-e084-47f4-8670-3cda12f246a7","name":"If Urgent","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[3100,200]},{"parameters":{"url":"https://script.google.com/macros/s/AKfycbyCOGo3ZIXszSlG8s2iNrsbdTVpu2NCjzWZkXZ-nyz3AS9CqH7KoQCHBwallIRiQ-o_ag/exec","sendQuery":true,"queryParameters":{"parameters":[{"name":"action","value":"star"},{"name":"message_id","value":"={{ $('Urgent Check').item.json.message_id }}"}]},"options":{"timeout":120000}},"id":"7899f854-2dcb-47a1-8e54-03b310cccf3f","name":"Star Email","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[3320,120]},